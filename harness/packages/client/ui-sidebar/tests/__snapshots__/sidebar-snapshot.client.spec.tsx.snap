// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`sidebar shell snapshots > renders the collapsed rail after the crossfade settles, in place 1`] = `
<div
  data-slot="sidebar"
  style="display: contents;"
>
  <div
    class="root fading quietBars"
    style="width: 300px;"
  >
    <div
      class="logoRow"
    >
      <img
        alt=""
        aria-hidden="true"
        class="brandCard"
        draggable="false"
        height="58"
        src="data:image/png;base64,"
        width="58"
      />
      <div
        class="headerControls"
      >
        <div
          class="headerTopRow"
        >
          <div
            data-slot="sidebar.header.action"
            style="display: contents;"
          />
          <button
            aria-label="Open sidebar"
            class="iconButton toggle"
            type="button"
          >
            <svg
              class="panelIcon"
              data-content="35f95b0c"
              fill="none"
              height="16"
              viewBox="0 0 16 16"
              width="16"
              xmlns="http://www.w3.org/2000/svg"
            />
          </button>
        </div>
        <button
          aria-label="New chat"
          class="iconButton newChat"
          type="button"
        >
          <svg
            data-content="c0ce4dcc"
            fill="none"
            height="16"
            viewBox="0 0 16 16"
            width="16"
            xmlns="http://www.w3.org/2000/svg"
          />
          <span
            class="newChatLabel"
          >
            New chat
          </span>
        </button>
      </div>
    </div>
    <div
      class="regionArea"
    >
      <div
        data-slot="sidebar.workspaces"
        style="display: contents;"
      />
    </div>
    <div
      class="footArea"
    >
      <div
        class="footerActions"
      >
        <div
          data-slot="sidebar.footer.action"
          style="display: contents;"
        />
      </div>
      <div
        class="settingsArea"
      >
        <div
          data-slot="sidebar.settings"
          style="display: contents;"
        />
      </div>
    </div>
  </div>
</div>
`;

