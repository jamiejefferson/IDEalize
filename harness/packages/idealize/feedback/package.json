{
  "name": "@idealize/feedback",
  "description": "IDEalize feedback + announcements: proxies V0's insert-only Supabase feedback table and the announcements feed",
  "version": "1.0.0-dev.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamiejefferson/IDEalize.git",
    "directory": "packages/idealize/feedback"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
